  m_Name: Lippke_main
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueScript
  dialogueText: "# Kommentare beginnen mit # oder //\n::start\nNPC: Moin. Suchst
    du was Bestimmtes?\n\n> Wer bist du?\n-> wer_1\n\n> Was machst du hier im Laden?\n->
    arbeit_1\n\n> Hast du einen Tipp f\xFCr mich?\nNPC: Frag mich das in f\xFCnf
    Minuten nochmal.\n-> start\n\n> Tsch\xFCss.\nNPC: Bis dann.\n-> end\n\n\n::wer_1\nNPC:
    (Text zur Person \u2026)\n\n> Und wie bist du zu Zensor gekommen?\n-> wer_2\n\n>
    Zur\xFCck.\n-> start\n\n\n::wer_2\nNPC: (\u2026)\n-> start"
  externalDialogue: {fileID: 0}
